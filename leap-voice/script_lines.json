[
 {
  "text": "في آخر الدوام،",
  "pace": "mid",
  "gap": 0.24
 },
 {
  "text": "قاعد لوحدك.",
  "pace": "slow",
  "gap": 0.3
 },
 {
  "text": "الزملا مشيوا،",
  "pace": "mid",
  "gap": 0.22
 },
 {
  "text": "والشاشة لسه منورة.",
  "pace": "mid",
  "gap": 0.34
 },
 {
  "text": "وفي دماغك سؤال:",
  "pace": "mid",
  "gap": 0.27
 },
 {
  "text": "أنا عندي إيه؟",
  "pace": "slow",
  "gap": 0.36
 },
 {
  "text": "غالباً بترد وتقول:",
  "pace": "fast",
  "gap": 0.25
 },
 {
  "text": "ما فيش حاجة مميزة.",
  "pace": "slow",
  "gap": 0.4
 },
 {
  "text": "بس اسأل نفسك سؤال تاني:",
  "pace": "mid",
  "gap": 0.27
 },
 {
  "text": "إيه اللي الناس بتطلبه منك في الشغل كل أسبوع؟",
  "pace": "fast",
  "gap": 0.38
 },
 {
  "text": "ترتيب ملف.",
  "pace": "fast",
  "gap": 0.21
 },
 {
  "text": "صياغة رسالة.",
  "pace": "fast",
  "gap": 0.23
 },
 {
  "text": "حل مشكلة صغيرة.",
  "pace": "fast",
  "gap": 0.31
 },
 {
  "text": "إنت بتعمل ده من غير ما تفكر.",
  "pace": "fast",
  "gap": 0.29
 },
 {
  "text": "وعشان كده",
  "pace": "mid",
  "gap": null
 },
 {
  "text": "مش شايفه مهارة.",
  "pace": "slow",
  "gap": 0.33
 },
 {
  "text": "اللي بييجي لك بسهولة",
  "pace": "mid",
  "gap": null
 },
 {
  "text": "بتفتكره عادي.",
  "pace": "mid",
  "gap": 0.26
 },
 {
  "text": "وغيرك",
  "pace": "mid",
  "gap": null
 },
 {
  "text": "ممكن يكون محتاجه.",
  "pace": "slow",
  "gap": 0.44
 },
 {
  "text": "الليلة:",
  "pace": "mid",
  "gap": 0.24
 },
 {
  "text": "خد ورقة واحدة،",
  "pace": "mid",
  "gap": null
 },
 {
  "text": "واكتب 3 حاجات الناس بتطلبها منك.",
  "pace": "fast",
  "gap": 0.22
 },
 {
  "text": "ما تحكمش عليهم.",
  "pace": "mid",
  "gap": 0.24
 },
 {
  "text": "بس اكتبهم.",
  "pace": "mid",
  "gap": 0.46
 },
 {
  "text": "وبعدين؟ بص:",
  "pace": "slow",
  "gap": 0.28
 },
 {
  "text": "أنهي واحدة فيهم كتبتها من غير",
  "pace": "fast",
  "gap": null
 },
 {
  "text": "تفكير؟",
  "pace": "fast",
  "gap": 0.32
 },
 {
  "text": "دي غالباً اللي شايفها عادي.",
  "pace": "mid",
  "gap": 0.36
 },
 {
  "text": "اللي بتقول عليه عادي،",
  "pace": "slow",
  "gap": null
 },
 {
  "text": "ممكن غيرك يحتاجه.",
  "pace": "slow",
  "gap": 0.4
 },
 {
  "text": "وسؤالك الجاي:",
  "pace": "mid",
  "gap": 0.26
 },
 {
  "text": "هل مهارتك بتنفع لحد؟",
  "pace": "slow",
  "gap": 0.42
 },
 {
  "text": "ده في البوست الجاي.",
  "pace": "fast",
  "gap": 0.3
 },
 {
  "text": "احفظ البوست",
  "pace": "fast",
  "gap": null
 },
 {
  "text": "وارجع له بعد ما تنفذ.",
  "pace": "fast",
  "gap": null
 }
]